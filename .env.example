# Configuration reference only. Python does NOT automatically read .env.
# Export variables in your shell; Compose reads .env for substitution only.
# All credentials and external service URLs are deliberately blank.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=
# Separate Django server-to-server credential (browser uses session/CSRF).
API_TOKEN=
DJANGO_DB_PATH=
ML_BACKEND=http
# For separately deployed ML only. tools/run_project.py supplies its local URL.
ML_SERVICE_URL=
ML_METADATA_URL=
# Shared between Django and ML. NOT an NVIDIA key.
ML_SERVICE_TOKEN=
# Configure your JMA GSM Forecast and Previous Runs endpoints; see README.
OPEN_METEO_FORECAST_URL=
OPEN_METEO_PREVIOUS_RUNS_URL=
# Optional for provider plans requiring a key. Never embed it in a URL.
OPEN_METEO_API_KEY=
HTTP_TIMEOUT=30
MODEL_PATH=models/production/model.json
# Explicit opt-in required for the committed provisional artifact.
ALLOW_PROVISIONAL_MODEL=0
# Legacy ML /power/forecast only; leave empty for the integrated direct-predict flow.
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_TOKEN=
WEATHER_TIMEOUT_SECONDS=15
ALLOW_HISTORICAL_FORECASTS=0
